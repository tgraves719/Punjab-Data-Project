# ---------------------------------------------------------------------------
# Public repo = explorer site (docs/), pipeline code, and open per-quarter data.
# The heavy source archives and private working material stay local only.
# ---------------------------------------------------------------------------

# Bound volume scans (25 GB of India Office PDFs) and any other PDF
Library 1/
Library 2/
*.pdf

# Rendered page images live ONLY in docs/pages/ (served by GitHub Pages).
# The pipeline's working copies are excluded.
pipeline/data/*/pages/

# Binary database (regenerable: python postprocess.py manifest_*.json)
punjab.db

# Model bake-off scratch: candidate extractions + _usage.json written by
# extract_api.py --out data/<quarter>/_baked/<model>. Never the canonical record.
pipeline/data/*/_baked/

# Prof. Davis's hand-transcription workbook (his working file, not ours to publish)
*.xlsx
*.xls

# Private interpretive memo — unpublished scholarship, shared directly instead
analysis/slice_1910/davis_memo_1910.md

# Python / OS noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Local build artifact (contains machine-local PDF deep-links); the published
# copy is docs/index.html, built with: python build_site.py --public
analysis/slice_1910/out/explore_1910.html

# OCR lab. Everything here is regenerable; the measurement RESULTS (the *.md
# memos, the small *_results.json, the fitted templates) are versioned because
# they are the evidence for D-016..D-019 and for the figures quoted to partners.
# What is excluded is bulk pixels and intermediate feature dumps.
analysis/ocr_lab/cropset/
analysis/ocr_lab/*montage*.png
analysis/ocr_lab/zoom_*.png
analysis/ocr_lab/loc_*.png
# Intermediate per-entry feature/curve dumps (MBs; regenerate with loc_fit.py,
# loc_lines_eval.py, loc_peak.py). loc_template.json / loc_eval.json /
# loc_diag.json are results and ARE tracked.
analysis/ocr_lab/loc_features.json
analysis/ocr_lab/loc_lines.json
analysis/ocr_lab/loc_curves.json

# Private correspondence drafts (unsent letters, personal email)
correspondence/

# Prof. Davis's bibliography, converted from the .docx he circulates. His
# unpublished scholarly work-in-progress -- ours to use, not ours to publish.
# Remove this line only once he has agreed to it appearing in a public repo.
bibliography/
